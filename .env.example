# Copie para .env (local) e cadastre as mesmas variáveis na Hostinger (variáveis de ambiente
# do site, usadas no build). Todas são opcionais e públicas por natureza (vão para o navegador).
# Valor vazio ou "-" = não configurado: o site funciona normalmente sem elas.

# Google Analytics 4 (ex.: G-XXXXXXXXXX)
PUBLIC_GA4_ID=
# Google Ads: ID da conta (ex.: AW-1234567890) e rótulos das conversões
PUBLIC_GADS_ID=
PUBLIC_GADS_LABEL_RESERVA=
PUBLIC_GADS_LABEL_DELIVERY=

# Pixel do Meta (ex.: 123456789012345)
PUBLIC_META_PIXEL_ID=
