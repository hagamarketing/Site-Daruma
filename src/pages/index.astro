---
import heroChef from '@/assets/fotos/daruma-inicio.avif';
import AlmocoDomingo from '@/components/sections/AlmocoDomingo.astro';
import Contato from '@/components/sections/Contato.astro';
import Delivery from '@/components/sections/Delivery.astro';
import FaixaMarca from '@/components/sections/FaixaMarca.astro';
import Galeria from '@/components/sections/Galeria.astro';
import Hero from '@/components/sections/Hero.astro';
import Instagram from '@/components/sections/Instagram.astro';
import Reservas from '@/components/sections/Reservas.astro';
import Rodizio from '@/components/sections/Rodizio.astro';
import Sobre from '@/components/sections/Sobre.astro';
import { faq } from '@/data/faq';
import Base from '@/layouts/Base.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })),
};
---

<Base imagem={heroChef} imagemAlt="Mesa do Daruma Temaki e Rolls com sashimis, rosa de salmão e outros pratos japoneses" jsonLd={[faqSchema]}>
  <Hero />
  <FaixaMarca />
  <Rodizio />
  <AlmocoDomingo />
  <Delivery />
  <Reservas />
  <Sobre />
  <Galeria />
  <Instagram />
  <Contato />
</Base>
