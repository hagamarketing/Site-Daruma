---
import SecaoTitulo from '@/components/ui/SecaoTitulo.astro';
import Botao from '@/components/ui/Botao.astro';
import Icone from '@/components/ui/Icone.astro';
import { depoimentos } from '@/data/depoimentos';
import { links, notaGoogle, site } from '@/data/site';

const lista = depoimentos;
const fmtData = (iso: string | null) =>
  iso
    ? new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
        new Date(iso),
      )
    : '';
---

<section id="avaliacoes" class="avaliacoes" aria-labelledby="avaliacoes-titulo" data-motion="contadores depoimentos">
  <div class="container-site">
    <div class="avaliacoes__topo">
      <SecaoTitulo id="avaliacoes-titulo" rotulo="Avaliações no Google">
        Quem janta aqui <em>volta e conta</em>
      </SecaoTitulo>
      <dl class="avaliacoes__numeros">
        <div>
          <dt>Nota média no Google</dt>
          <dd>
            <span class="avaliacoes__numero" data-contador-alvo={site.google.nota} data-decimais="1">{notaGoogle}</span>
            <span class="avaliacoes__de">de 5</span>
          </dd>
        </div>
        <div>
          <dt>Avaliações</dt>
          <dd>
            <span class="avaliacoes__numero" data-contador-alvo={site.google.avaliacoes} data-sufixo="+">
              {site.google.avaliacoes}+
            </span>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="avaliacoes__janela" data-carrossel tabindex="0" role="region" aria-label="Depoimentos de clientes (role para os lados)">
    <ul role="list" class="avaliacoes__trilho" data-carrossel-trilho>
      {
        lista.map((d) => (
          <li class="depoimento">
            <figure>
              <p class="depoimento__nota">
                <span aria-hidden="true">{'★'.repeat(d.nota)}{'☆'.repeat(5 - d.nota)}</span>
                <span class="sr-only">Nota {d.nota} de 5</span>
              </p>
              <blockquote>
                <p>{d.texto}</p>
              </blockquote>
              <figcaption>
                <strong>{d.nome}</strong>
                {d.data && <span>{fmtData(d.data)}</span>}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container-site avaliacoes__rodape">
    <div class="avaliacoes__controles" data-carrossel-controles hidden>
      <button type="button" class="btn btn-fantasma btn-pequeno" data-carrossel-acao="anterior">
        <span aria-hidden="true">←</span> Anterior
      </button>
      <button type="button" class="btn btn-fantasma btn-pequeno" data-carrossel-acao="proximo">
        Próximo <span aria-hidden="true">→</span>
      </button>
    </div>
    <Botao href={links.avaliarGoogle} evento="avaliar_google" variante="secundario">
      <Icone nome="estrela" tamanho={18} /> Avaliar no Google
    </Botao>
  </div>
</section>

<style>
  .avaliacoes {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    background: var(--color-sumi-900);
    border-block: 1px solid var(--color-sumi-700);
  }
  .avaliacoes__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  .avaliacoes__numeros {
    display: flex;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .avaliacoes__numeros dt {
    font-size: 0.8125rem;
    color: var(--color-washi-300);
  }
  .avaliacoes__numeros dd {
    margin: 0;
  }
  .avaliacoes__numero {
    display: inline-block;
    min-width: 2.5ch;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    line-height: 1;
    color: var(--color-gold-400);
    font-variant-numeric: tabular-nums;
  }
  .avaliacoes__de {
    margin-left: 0.25rem;
    color: var(--color-washi-300);
  }
  .avaliacoes__janela {
    position: relative;
    scroll-padding-inline: var(--recuo-container);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
  }
  .avaliacoes__janela:focus-visible {
    outline-offset: -2px;
  }
  .avaliacoes__trilho {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    margin: 0;
    padding: 0 var(--recuo-container);
  }
  .depoimento {
    width: min(85vw, 24rem);
    scroll-snap-align: start;
  }
  .depoimento figure {
    display: grid;
    gap: 1rem;
    height: 100%;
    margin: 0;
    padding: 1.75rem;
    border: 1px solid var(--color-sumi-700);
    border-radius: var(--radius-cartao);
    background: var(--color-sumi-800);
  }
  .depoimento__nota {
    color: var(--color-gold-400);
    letter-spacing: 0.15em;
  }
  .depoimento blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .depoimento figcaption {
    display: grid;
    align-self: end;
    font-size: 0.875rem;
    color: var(--color-washi-300);
  }
  .depoimento figcaption strong {
    color: var(--color-washi-50);
  }
  .avaliacoes__rodape {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
  .avaliacoes__controles {
    display: flex;
    gap: 0.25rem;
  }
  .avaliacoes__controles[hidden] {
    display: none;
  }
  .avaliacoes__janela:global(.carrossel--arrastavel) {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
    user-select: none;
  }
</style>
