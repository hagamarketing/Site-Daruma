---
import Foto from '@/components/ui/Foto.astro';
import SecaoTitulo from '@/components/ui/SecaoTitulo.astro';
import Kanji from '@/components/ui/Kanji.astro';
import RodizioPrecos from '@/components/sections/RodizioPrecos.astro';
import { etapas } from '@/data/rodizio';

const lista = etapas;
const total = String(lista.length).padStart(2, '0');
---

<section id="rodizio" class="rodizio" aria-labelledby="rodizio-titulo" data-rodizio data-motion="rodizio">
  <Kanji palavra="rodizio" vertical class="rodizio__kanji" />
  <div class="container-site rodizio__cabeca">
    <SecaoTitulo id="rodizio-titulo" rotulo="Rodízio japonês">
      O Melhor Rodízio e o <em>Melhor Menu À La Carte.</em>
      <p slot="intro">Você pede, a cozinha prepara e a mesa vai se enchendo. Da entrada à sobremesa.</p>
    </SecaoTitulo>
    <p class="rodizio__contador" aria-hidden="true" data-contador>
      <span data-contador-atual>01</span><span class="rodizio__contador-total">/ {total}</span>
    </p>
  </div>

  <div class="rodizio__janela" data-rodizio-janela tabindex="0" role="region" aria-label="Fotos do rodízio (role para os lados)">
    <ol role="list" class="rodizio__trilho" data-rodizio-trilho>
      {
        lista.map((etapa) => (
          <li class="etapa" data-etapa>
            <div class="etapa__foto">
              <Foto src={etapa.foto} alt={etapa.alt} sizes="(min-width: 64rem) 32vw, 80vw" larguras={[400, 640, 900, 1200]} />
            </div>
          </li>
        ))
      }
    </ol>
  </div>

</section>

<RodizioPrecos />

<style>
  .rodizio {
    position: relative;
    overflow: clip;
    padding-block: clamp(5rem, 4rem + 5vw, 9rem);
  }
  .rodizio :global(.rodizio__kanji) {
    position: absolute;
    top: 2rem;
    left: -1rem;
    font-size: clamp(5rem, 3rem + 8vw, 12rem);
  }
  .rodizio__cabeca {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .rodizio__contador {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rodizio__contador-total {
    margin-left: 0.3em;
    font-size: 0.4em;
    color: var(--color-washi-300);
  }
  /* Sem JS: rolagem horizontal nativa com snap. Com JS, a etapa de animação fixa a seção. */
  .rodizio__janela {
    position: relative;
    scroll-padding-inline: var(--recuo-container);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: 1rem;
  }
  .rodizio__trilho {
    display: flex;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    width: max-content;
    margin: 0;
    padding: 0 var(--recuo-container);
  }
  .etapa {
    display: grid;
    gap: 1.25rem;
    width: min(80vw, 26rem);
    scroll-snap-align: start;
  }
  .etapa__foto {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-cartao);
    background: var(--color-sumi-800);
  }
  .etapa__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /*
   * Modo fixo (JS, desktop/tablet): a seção ocupa exatamente a altura da tela e a rolagem vertical
   * move o trilho. O título e as fotos dividem a altura; a foto se ajusta ao espaço que sobra
   * (unidades de contêiner), então os cards nunca ficam cortados em telas baixas (ex.: 1366×768).
   */
  .rodizio:global(.rodizio--fixo) {
    --foto-etapa: min(100cqh, 40rem);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100svh;
    padding-block: 5.75rem clamp(1.5rem, 5svh, 3rem);
  }
  .rodizio:global(.rodizio--fixo) .rodizio__cabeca :global(.secao-titulo) {
    gap: 0.5rem;
    margin-bottom: clamp(1rem, 3svh, 2rem);
  }
  .rodizio:global(.rodizio--fixo) .rodizio__contador {
    margin-bottom: clamp(1rem, 3svh, 2rem);
    font-size: clamp(2.5rem, 7svh, 5rem);
  }
  .rodizio:global(.rodizio--fixo) .rodizio__janela {
    container-type: size;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    padding-bottom: 0;
  }
  .rodizio:global(.rodizio--fixo) .rodizio__trilho {
    height: 100%;
  }
  /* Largura pela tela (não pela altura): garante percurso horizontal de verdade em qualquer notebook. */
  .rodizio:global(.rodizio--fixo) .etapa {
    align-content: start;
    gap: 1rem;
    width: clamp(17rem, 32vw, 30rem);
  }
  .rodizio:global(.rodizio--fixo) .etapa__foto {
    width: 100%;
    height: var(--foto-etapa);
    aspect-ratio: auto;
  }
  /* Telas muito baixas: esconde a introdução para sobrar espaço para os cards. */
  @media (max-height: 800px) {
    .rodizio:global(.rodizio--fixo) .rodizio__cabeca :global(.secao-titulo__intro) {
      display: none;
    }
  }
  /* Movimento reduzido: lista vertical. */
  @media (prefers-reduced-motion: reduce) {
    .rodizio__janela {
      overflow: visible;
    }
    .rodizio__trilho {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
      width: auto;
    }
    .etapa {
      width: auto;
    }
    .rodizio__contador {
      display: none;
    }
  }
</style>
