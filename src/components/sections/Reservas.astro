---
/** Reservas: formulário guiado pelo WhatsApp + grupos e aniversários. */
import Botao from '@/components/ui/Botao.astro';
import Cartao from '@/components/ui/Cartao.astro';
import FormReserva from '@/components/ui/FormReserva.astro';
import Kanji from '@/components/ui/Kanji.astro';
import SecaoTitulo from '@/components/ui/SecaoTitulo.astro';
import StatusBadge from '@/components/ui/StatusBadge.astro';
import TabelaHorarios from '@/components/ui/TabelaHorarios.astro';
import { linkWhatsApp, links, mensagens, site } from '@/data/site';

/** Regras para grupos e aniversários. */
const regrasGrupos = '[PREENCHER] Regras para grupos: a partir de quantas pessoas, antecedência, sinal, bolo de fora.';
---

<section id="reservas" class="reservas" aria-labelledby="reservas-titulo">
  <Kanji palavra="desejo" class="reservas__kanji" />
  <div class="container-site">
    <SecaoTitulo id="reservas-titulo" rotulo="Reservas">
      Faça o pedido. <em>A gente pinta o olho.</em>
      <p slot="intro">Escolha o dia, o horário e quantas pessoas. A mensagem sai pronta no WhatsApp para você enviar.</p>
    </SecaoTitulo>
  </div>
  <div class="container-site reservas__grade">
    <Cartao class="reservas__form">
      <h3 class="text-subtitulo">Reservar mesa</h3>
      <FormReserva />
    </Cartao>

    <aside class="reservas__lado" aria-label="Horários e contato">
      <StatusBadge />
      <TabelaHorarios />
      <p class="reservas__contato">
        Prefere ligar? <a href={links.telefone} data-evento="ligacao">{site.telefone.exibicao}</a>
      </p>
    </aside>
  </div>

  <div class="container-site grupos">
    <p class="rotulo">Grupos e aniversários</p>
    <h3 class="text-subtitulo">Mesa grande, <em>festa pequena</em></h3>
    <p class="grupos__texto">
      Aniversário, confraternização ou a família inteira no domingo: conte quantas pessoas e a ocasião que a gente
      organiza a mesa.
    </p>
    <p class="grupos__info">{regrasGrupos}</p>
    <Botao href={linkWhatsApp(mensagens.grupos)} evento="reserva_whatsapp" variante="secundario" olho>
      Falar sobre um grupo
    </Botao>
  </div>
</section>


<style>
  .reservas {
    position: relative;
    overflow: clip;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    border-block: 1px solid var(--color-sumi-700);
    background: var(--color-sumi-900);
  }
  .reservas :global(.reservas__kanji) {
    position: absolute;
    top: 2rem;
    right: -2rem;
    opacity: 0.035;
  }
  .reservas__grade {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-bottom: 4rem;
  }
  @media (min-width: 64rem) {
    .reservas__grade {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }
  .reservas :global(.reservas__form) {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }
  .reservas__lado {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .reservas__contato a {
    color: var(--color-salmon-400);
  }
  .grupos {
    position: relative;
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding-top: 3rem;
  }
  .grupos__texto {
    max-width: 58ch;
    color: var(--color-washi-300);
  }
  .grupos__info {
    max-width: 60ch;
    margin-bottom: 1.5rem;
    color: var(--color-washi-300);
  }
</style>
