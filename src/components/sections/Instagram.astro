---
import Foto from '@/components/ui/Foto.astro';
import SecaoTitulo from '@/components/ui/SecaoTitulo.astro';
import Botao from '@/components/ui/Botao.astro';
import { instagram } from '@/data/galeria';
import { links } from '@/data/site';

const posts = instagram;
const perfil = `@${new URL(links.instagram).pathname.replaceAll('/', '')}`;
---

<section class="insta" aria-labelledby="insta-titulo">
  <div class="container-site insta__grade">
    <div class="insta__texto">
      <SecaoTitulo id="insta-titulo" rotulo="Instagram">
        O que saiu <em>do balcão hoje</em>
        <p slot="intro">Pratos novos, bastidores e avisos da casa em {perfil}.</p>
      </SecaoTitulo>
      <Botao href={links.instagram} variante="secundario">Seguir {perfil}</Botao>
    </div>
    <ul role="list" class="insta__fotos">
      {
        posts.map((p) => (
          <li>
            {p.link ? (
              <a href={p.link} target="_blank" rel="noopener">
                <Foto src={p.foto} alt={p.alt} sizes="(min-width: 64rem) 16vw, 30vw" larguras={[240, 400, 600]} />
                <span class="sr-only"> (abre o post no Instagram, em nova aba)</span>
              </a>
            ) : (
              <Foto src={p.foto} alt={p.alt} sizes="(min-width: 64rem) 16vw, 30vw" larguras={[240, 400, 600]} />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .insta {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
  }
  .insta__grade {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .insta__grade {
      grid-template-columns: 1fr 1.4fr;
      gap: 4rem;
    }
  }
  .insta__fotos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .insta__fotos li {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--color-sumi-800);
  }
  .insta__fotos :global(picture),
  .insta__fotos :global(img),
  .insta__fotos a {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
