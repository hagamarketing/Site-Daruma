---
import type { Pergunta } from '@/data/faq';

/** Perguntas frequentes com <details>: funcionam sem JS. O JSON-LD FAQPage fica na página. */
interface Props {
  perguntas: Pergunta[];
}
const { perguntas } = Astro.props;
---

<div class="perguntas">
  {
    perguntas.map((p) => (
      <details>
        <summary>
          <span>{p.pergunta}</span>
          <span class="perguntas__icone" aria-hidden="true" />
        </summary>
        <p>{p.resposta}</p>
      </details>
    ))
  }
</div>

<style>
  .perguntas {
    border-top: 1px solid var(--color-sumi-700);
  }
  details {
    border-bottom: 1px solid var(--color-sumi-700);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--color-salmon-400);
  }
  .perguntas__icone {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .perguntas__icone::before,
  .perguntas__icone::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease-saida);
  }
  .perguntas__icone::after {
    transform: rotate(90deg);
  }
  details[open] .perguntas__icone::after {
    transform: rotate(0deg);
  }
  details p {
    max-width: 65ch;
    padding-bottom: 1.5rem;
    color: var(--color-washi-300);
  }
</style>
