---
import Daruma from '@/components/ui/Daruma.astro';

interface Props {
  class?: string;
}
const { class: classe } = Astro.props;
---

<a href="/" class:list={['logo', classe]}>
  <Daruma variante="cheio" olhos="um" class="logo__boneco" />
  <span class="logo__texto">
    <span class="logo__nome">Daruma</span>
    <span class="logo__sub">Temaki e Rolls</span>
  </span>
  <span class="sr-only">, página inicial</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-washi-50);
    text-decoration: none;
  }
  .logo :global(.logo__boneco) {
    width: 2.1rem;
    height: auto;
  }
  .logo__texto {
    display: grid;
    line-height: 1;
  }
  .logo__nome {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: -0.01em;
  }
  .logo__sub {
    margin-top: 0.15rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-washi-300);
    white-space: nowrap;
  }
</style>
