---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Foto responsiva (AVIF/WebP + srcset). Lazy por padrão; use `prioridade` só na imagem LCP. */
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  larguras?: number[];
  prioridade?: boolean;
  class?: string;
  classeImg?: string;
  /** Cursor personalizado "Ver" (desktop, etapa premium). */
  ver?: boolean;
}
const {
  src,
  alt,
  sizes,
  larguras = [400, 640, 960, 1280],
  prioridade = false,
  class: classe,
  classeImg,
  ver,
} = Astro.props;
const widths = larguras.filter((w) => w <= src.width);
if (widths.length === 0) widths.push(src.width);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  quality={prioridade ? 60 : 70}
  loading={prioridade ? 'eager' : 'lazy'}
  decoding={prioridade ? 'sync' : 'async'}
  fetchpriority={prioridade ? 'high' : 'auto'}
  pictureAttributes={{ class: classe, ...(ver ? { 'data-cursor': 'Ver' } : {}) }}
  class={classeImg}
/>
