---
/** Ícone do olho do Daruma para CTAs. Decorativo. */
interface Props {
  pintado?: boolean;
  class?: string;
}
const { pintado = true, class: classe } = Astro.props;
---

<svg
  class:list={['olho-daruma', classe]}
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  aria-hidden="true"
  data-pintado={pintado ? 'true' : 'false'}
>
  <circle cx="12" cy="12" r="9.25" stroke="currentColor" stroke-width="1.5" />
  <path
    class="olho-daruma__pupila"
    d="M12 9.5a2.5 2.5 0 1 1 0 5a2.5 2.5 0 1 1 0 -5"
    stroke="currentColor"
    stroke-width="5"
    stroke-linecap="round"
    pathLength="1"
  />
</svg>

<style>
  .olho-daruma {
    flex: none;
  }
  .olho-daruma[data-pintado='false'] .olho-daruma__pupila {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
</style>
